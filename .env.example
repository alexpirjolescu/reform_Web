# Copy to .env.local and fill in. Never commit .env.local.
# Values: Supabase dashboard → Project Settings → API Keys / Data API.

# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the About page (optional)
NEXT_PUBLIC_CONTACT_EMAIL=

# Server only: bypasses row level security. Used for invites and admin actions.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server only, optional: GIF search in messages (developers.giphy.com). Without it, stickers still work.
GIPHY_API_KEY=
